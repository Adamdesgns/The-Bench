# THE BENCH — environment (names only, never real values)
#
# KEYS DO NOT LIVE IN THE APP. Credentials are held by the MCP servers or the
# host environment. This file exists only for the OPTIONAL local dev runner
# (server/reviewer.js) when you run it directly. The app itself reads NO keys —
# it talks to connections configured in Settings (db/connections.json), which
# stores endpoints + policy only, never secrets.

# --- Optional local dev runner only (not used by the app) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ALPHAVANTAGE_KEY=
ALPHAVANTAGE_DAILY_BUDGET=25

# Which provider runs each analysis step (openai | anthropic)
MODEL_PROVIDER=
BENCH_PROVIDER=
MARQUEE_PROVIDER=
OPENAI_MODEL=
ANTHROPIC_MODEL=

# --- Connections (set these in the app's Settings, not here) ---
# MCP endpoints for: Claude · OpenAI · Hermes agents · Robinhood (execution).
# These are references, not secrets. Robinhood MCP handles order placement;
# no brokerage credentials ever touch this repo.
