# THE BENCH — environment keys (names only, never real values)
# Copy to .env and fill in. .env is gitignored.

# --- Model providers (you can set one or both) ---
# The runner works with either. Set the keys you have.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which provider runs each step. Values: openai | anthropic
# MODEL_PROVIDER is the default for both steps; BENCH_/MARQUEE_ override per step.
# If MODEL_PROVIDER is unset, the runner uses whichever key is present.
MODEL_PROVIDER=
BENCH_PROVIDER=
MARQUEE_PROVIDER=

# Model IDs per provider (optional — sensible defaults are built in).
OPENAI_MODEL=
ANTHROPIC_MODEL=

# --- Market data ---
# Alpha Vantage free tier = 25 calls/day. Without it (or once the daily budget
# is spent) the data layer falls back to Stooq, labeled delayed/provisional.
ALPHAVANTAGE_KEY=
# How many AV calls the runner may spend per day (<= your plan's cap).
ALPHAVANTAGE_DAILY_BUDGET=25

# NEVER put brokerage credentials here. The system never places trades.
# NEVER put X/Twitter credentials here. Publishing is manual by design.
