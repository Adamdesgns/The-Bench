# THE BENCH — environment keys (names only, never real values)
# Copy to .env and fill in. .env is gitignored.

# Required: OpenAI (or model provider) key for the v17 + Marquee calls
OPENAI_API_KEY=

# Optional: Alpha Vantage market data. Free tier = 25 calls/day.
# Without it the data layer falls back to Stooq (delayed/provisional).
ALPHAVANTAGE_KEY=

# NEVER put brokerage credentials here. The system never places trades.
# NEVER put X/Twitter credentials here. Publishing is manual by design.
