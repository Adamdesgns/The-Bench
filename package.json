{
  "name": "the-bench",
  "version": "0.5.0",
  "private": true,
  "description": "THE BENCH - local research workstation plus an invite-only, tenant-isolated web beta. No order routing.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "seed": "node scripts/seed-archive.js",
    "start": "node server/index.js",
    "start:web": "node server/web.js",
    "invite:beta": "node scripts/invite-beta-user.js",
    "run:market": "node server/reviewer.js",
    "run:mock": "node server/reviewer.js --mock",
    "mcp": "node server/mcp.js",
    "score": "node scripts/score-book.js",
    "score:dry": "node scripts/score-book.js --dry-run",
    "backfill:triggers": "node scripts/backfill-triggers.js",
    "lint:article": "node server/lint.js",
    "app": "electron .",
    "dist:win": "electron-builder --win --x64",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.thebenchtrades.bench",
    "productName": "The Bench",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "server/**",
      "public/**",
      "prompts/**",
      "db/archive.json",
      "db/challenge.json",
      "db/archive-v4.xlsx",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "The-Bench-Setup-${version}.${ext}"
    }
  }
}
