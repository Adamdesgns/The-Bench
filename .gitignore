# Secrets — never commit
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Archive backups (the live archive.json IS committed; backups are not)
db/*.backup.json
db/*.bak

# Runner runtime state (regenerated each run)
db/av-usage.json
db/archive.lock/

# OS / editor
.DS_Store
*.log
npm-debug.log*

# stray build artifacts
*.tar.gz
